# Copiar a .env.local y completar con valores reales.

# --- PostgreSQL -------------------------------------------------------------
# Local (docker compose up -d levanta esta misma base en el puerto 5433):
DATABASE_URL="postgresql://stockpilot:stockpilot@localhost:5433/stockpilot"

# Producción (Neon / Supabase) requiere SSL. Poner en "true" en ese caso.
DATABASE_SSL="false"

# --- Auth.js (NextAuth) -----------------------------------------------------
# Generar con: npx auth secret   (o) openssl rand -base64 32
AUTH_SECRET="reemplazar-por-un-secreto-de-32-bytes-en-base64"

# URL pública de la app. En Vercel se infiere sola; en local dejar así.
# (npm run dev usa el puerto 3100 para no chocar con Docker Desktop.)
AUTH_URL="http://localhost:3100"

# --- Seed -------------------------------------------------------------------
# Contraseña que se asigna a los usuarios demo generados por `npm run db:seed`.
SEED_PASSWORD="demo1234"
